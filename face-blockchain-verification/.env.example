# SerpApi key for reverse-image search
SERPAPI_KEY=

# Face similarity threshold (float between 0 and 1)
FACE_SIMILARITY_THRESHOLD=0.65

# Whether to attempt GPU (set to 1 to try GPU, 0 for CPU)
USE_GPU=0

# SerpApi request timeout seconds
SERPAPI_TIMEOUT=30

# Maximum bytes to download for candidate images (default 5MB)
MAX_IMAGE_DOWNLOAD_BYTES=5242880

# Polygon Amoy blockchain settings (optional until the contract is deployed)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
WALLET_ADDRESS=
PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=80002
